# =============================================================================
# Protheus PC - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed.

# Backend
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Paths (relative to project root, used inside containers)
REFERENCIAS_DIR=/app/data/referencias
TMP_DIR=/app/data/tmp

# Limites
MAX_UPLOAD_MB=20
MAX_FILES_POR_PROCESSAMENTO=20
